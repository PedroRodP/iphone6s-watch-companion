{
  "name": "web-watch-companion",
  "version": "1.0.0",
  "description": "Web Watch Companion — turn any device with a browser into a secondary alert screen (WhatsApp notifications and beyond)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "tray": "wscript tray/launch.vbs",
    "dist": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/build-installer.ps1",
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/nosleep.js/dist/NoSleep.min.js','public/NoSleep.min.js')\""
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^4.18.2",
    "nosleep.js": "^0.12.0",
    "ws": "^8.14.2"
  }
}
